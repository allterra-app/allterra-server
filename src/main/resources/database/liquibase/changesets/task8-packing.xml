<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="task8-create-trip-gear" author="ai-agent">
        <createTable tableName="trip_gear">
            <column name="trip_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="gear_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="is_packed" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="trip_gear"
                       columnNames="trip_id, gear_id"
                       constraintName="pk_trip_gear"/>

        <addForeignKeyConstraint baseTableName="trip_gear"
                                 baseColumnNames="trip_id"
                                 referencedTableName="trips"
                                 referencedColumnNames="id"
                                 constraintName="fk_trip_gear_trip_id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="trip_gear"
                                 baseColumnNames="gear_id"
                                 referencedTableName="gear_items"
                                 referencedColumnNames="id"
                                 constraintName="fk_trip_gear_gear_id"
                                 onDelete="CASCADE"/>

        <createIndex tableName="trip_gear" indexName="idx_trip_gear_trip_id">
            <column name="trip_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
