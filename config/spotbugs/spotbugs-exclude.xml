<FindBugsFilter>
    <!-- Ignore faults in MapStruct generated classes -->
    <Match>
        <Class name="~.*MapperImpl" />
    </Match>
    <!-- Ignore SECHCP warnings in test classes -->
    <Match>
        <Bug code="SECHCP" />
        <Class name="~.*Test" />
    </Match>
    <!-- Ignore Lombok generated warnings  -->
    <Match>
        <Class name="~.*"/>
        <Method name="(equals|hashCode|toString)"/>
    </Match>
</FindBugsFilter>